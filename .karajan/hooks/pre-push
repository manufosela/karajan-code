#!/usr/bin/env sh
set -e
# karajan-code v4 (KJC-TSK-0641). Replaces the stale kj-harden block: the
# full `npm test` per push is redundant here (CI runs the suite on every PR)
# and unusably slow at this repo's push cadence — dogfooding note filed to
# make harden's test-on-push configurable.

# Identity guard — never push without a configured git identity.
if [ -z "$(git config user.email)" ] || [ -z "$(git config user.name)" ]; then
  echo 'kj harden: git user.name/user.email not set — refusing to push'; exit 1
fi

# Chain the developer's global pre-push (protected-branch guard) when present.
if [ -x "$HOME/.git-hooks/pre-push" ]; then
  "$HOME/.git-hooks/pre-push" "$@" || exit 1
fi
