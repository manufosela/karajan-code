#!/usr/bin/env sh
set -e
# >>> kj:managed:hook:post-merge v1 >>> (do not edit: regenerated by kj harden)
# Refresh the local RAG index so retrieval never serves stale code.
# KJC-BUG-0381: detached, so the merge never waits for it (one took 15 minutes),
# and one at a time: a lock in the git dir holding the run's pid, freed only when
# that process is gone (a lock with no pid, after an hour).
if command -v kj >/dev/null 2>&1; then
  kj_git_dir=$(git rev-parse --git-dir 2>/dev/null) || kj_git_dir=.git
  kj_lock="$kj_git_dir/kj-rag-index.lock"
  if [ -d "$kj_lock" ]; then
    # HU-3936: set -e. A lock with no pid yet (another run wrote none) is the stale case below, not an exit.
    kj_pid=$(cat "$kj_lock/pid" 2>/dev/null || true)
    if [ -n "$kj_pid" ]; then kill -0 "$kj_pid" 2>/dev/null || rm -rf "$kj_lock"
    else find "$kj_lock" -maxdepth 0 -mmin +60 -exec rm -rf {} \; 2>/dev/null; fi
  fi
  if mkdir "$kj_lock" 2>/dev/null; then
    ( kj rag index --since auto >"$kj_git_dir/kj-rag-index.log" 2>&1; rm -rf "$kj_lock" ) </dev/null >/dev/null 2>&1 &
    # HU-3936: a subshell, because dash fails the redirection even with 2>/dev/null on the command
    # (KJC-BUG-0521); the indexer may already have removed the lock.
    ( echo $! >"$kj_lock/pid" ) 2>/dev/null || true
  fi
fi
# Chain the repo's own hook in .git/hooks, looked up when the hook runs (KJC-BUG-0509, HU-2762).
kj_repo="$(git rev-parse --git-common-dir 2>/dev/null || true)/hooks"
if [ -n "$kj_repo" ] && [ -x "$kj_repo/post-merge" ] && [ "$(cd "$kj_repo" 2>/dev/null && pwd -P)" != "$(cd "$(dirname "$0")" && pwd -P)" ]; then
  "$kj_repo/post-merge" "$@"; rc=$?
  [ "$rc" -eq 0 ] || exit "$rc"
fi
# Chain the machine's global hook, looked up when the hook runs (KJC-TSK-0645, HU-2762).
kj_global=$(git config --global --type=path --get core.hooksPath 2>/dev/null || true)
if [ -n "$kj_global" ] && [ -x "$kj_global/post-merge" ] && [ "$(cd "$kj_global" 2>/dev/null && pwd -P)" != "$(cd "$(dirname "$0")" && pwd -P)" ]; then
  "$kj_global/post-merge" "$@"; rc=$?
  [ "$rc" -eq 0 ] || exit "$rc"
fi
# <<< kj:managed:hook:post-merge <<<
