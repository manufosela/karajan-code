#!/usr/bin/env sh
set -e
# >>> kj:managed:hook:commit-msg v1 >>> (do not edit: regenerated by kj harden)
# KJC-TSK-1401: one line per attempt in .karajan/harness/commit-gate.jsonl (time, outcome, rule;
# never the message) for kj stage's Git gates station. Best effort: a trace that cannot be
# written never blocks a commit, it only goes missing from the stage.
# The write is in a subshell: dash aborts the whole hook on a failed redirection (KJC-BUG-0521).
kj_trace() { mkdir -p .karajan/harness 2>/dev/null && ( printf '{"at":"%s","outcome":"%s","rule":"%s"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" >> .karajan/harness/commit-gate.jsonl ) 2>/dev/null || :; return 0; }
kj_refuse() { kj_trace refuse "$1"; echo "$2"; exit 1; }
msg_file="$1"
header=$(head -n1 "$msg_file")
# KJC-TSK-1390 (ADR 0045): the project's convention (kj gates value commit-convention):
# free or the project's own commitlint skip this header check; anything else keeps it.
kj_conv=conventional
if command -v kj >/dev/null 2>&1; then kj_conv=$(kj gates value commit-convention 2>/dev/null) || kj_conv=conventional; fi
# HU-3591: what commitlint ignores is valid whole to it, length caps included. Tested on the header only.
kj_ignored=no
if printf '%s\n' "$header" | grep -qE '^(Merge |Revert "|(fixup|squash|amend)!)'; then kj_ignored=yes; fi
case "$kj_ignored:$kj_conv" in
  yes:*|no:free|no:project) ;;
  *)
    # The scope is anything but a closing parenthesis, as in commitlint's parser.
    if ! printf '%s' "$header" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]*\))?!?: .+'; then
      kj_refuse header 'kj harden: commit header must follow Conventional Commits (type: subject)'
    fi
    # config-conventional subject-case (sentence/start/pascal/upper all start uppercase) and
    # subject-full-stop, for which an ellipsis is no full stop.
    kj_subject=$(printf '%s' "$header" | sed -E 's/^[a-z]+(\([^)]*\))?!?: //')
    case "$kj_subject" in
      [[:upper:]]*) kj_refuse subject-case 'kj harden: commit subject must start in lowercase' ;;
      *...) ;;
      *.) kj_refuse full-stop 'kj harden: commit subject must not end with a full stop' ;;
    esac
    ;;
esac
# HU-3591: length as commitlint counts it (UTF-16 units): UTF-8 code points (bytes that are not
# continuation bytes) plus one per 4-byte lead byte, which is a surrogate pair.
kj_len() { kj_a=$(printf '%s' "$1" | LC_ALL=C tr -d '\200-\277' | wc -c); kj_b=$(printf '%s' "$1" | LC_ALL=C tr -cd '\360-\367' | wc -c); echo $((kj_a + kj_b)); }
if [ "$kj_ignored" = no ] && [ "$(kj_len "$header")" -gt 100 ]; then kj_refuse length 'kj harden: commit header exceeds 100 chars'; fi
# KJC-TSK-0909, HU-3591: every line from line 2 on is body to commitlint. # lines are skipped on purpose
# (git strips them from editor commits); a -F message with a long # line is judged only by CI's commitlint.
# awk prefilters by bytes (never fewer than chars), kj_len settles the rest.
kj_long=$(LC_ALL=C awk 'NR >= 2 && !/^#/ && length($0) > 100' "$msg_file")
if [ "$kj_ignored" = no ] && [ -n "$kj_long" ] && [ -n "$(printf '%s\n' "$kj_long" | while IFS= read -r kj_line; do [ "$(kj_len "$kj_line")" -gt 100 ] && echo x; done)" ]; then
  kj_refuse body 'kj harden: a commit body line exceeds 100 chars (CI commitlint rejects it)'
fi
if [ -x node_modules/.bin/commitlint ]; then
  node_modules/.bin/commitlint --edit "$msg_file" || { kj_trace refuse commitlint; exit 1; }
fi
if grep -qiE 'co-authored-by:.*(claude|anthropic|openai|chatgpt|codex|gpt-?[0-9]|copilot|gemini|cursor|windsurf|codeium|deepseek)|(generated|written|authored|assisted|powered|created|made) (by|with|using) .*(claude|anthropic|openai|chatgpt|codex|gpt-?[0-9]|copilot|gemini|cursor|windsurf|codeium|deepseek)' "$msg_file"; then
  kj_refuse attribution 'kj harden: AI attribution is not allowed in commit messages'
fi
# Chain the repo's own hook in .git/hooks, looked up when the hook runs (KJC-BUG-0509, HU-2762).
kj_repo="$(git rev-parse --git-common-dir 2>/dev/null || true)/hooks"
if [ -n "$kj_repo" ] && [ -x "$kj_repo/commit-msg" ] && [ "$(cd "$kj_repo" 2>/dev/null && pwd -P)" != "$(cd "$(dirname "$0")" && pwd -P)" ]; then
  if "$kj_repo/commit-msg" "$@"; then :; else rc=$?; kj_trace refuse repo-hook; exit "$rc"; fi
fi
# Chain the machine's global hook, looked up when the hook runs (KJC-TSK-0645, HU-2762).
kj_global=$(git config --global --type=path --get core.hooksPath 2>/dev/null || true)
if [ -n "$kj_global" ] && [ -x "$kj_global/commit-msg" ] && [ "$(cd "$kj_global" 2>/dev/null && pwd -P)" != "$(cd "$(dirname "$0")" && pwd -P)" ]; then
  if "$kj_global/commit-msg" "$@"; then :; else rc=$?; kj_trace refuse global-hook; exit "$rc"; fi
fi
kj_trace pass ok
# <<< kj:managed:hook:commit-msg <<<
