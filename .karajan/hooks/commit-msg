#!/usr/bin/env sh
set -e
# >>> kj:managed:hook:commit-msg v1 >>> (do not edit: regenerated by kj harden)
# KJC-TSK-1401: one line per attempt in .karajan/harness/commit-gate.jsonl (time, outcome, rule;
# never the message) for kj stage's Git gates station. Best effort: a trace that cannot be
# written never blocks a commit, it only goes missing from the stage.
kj_trace() { mkdir -p .karajan/harness 2>/dev/null && printf '{"at":"%s","outcome":"%s","rule":"%s"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" >> .karajan/harness/commit-gate.jsonl 2>/dev/null; return 0; }
kj_refuse() { kj_trace refuse "$1"; echo "$2"; exit 1; }
msg_file="$1"
header=$(head -n1 "$msg_file")
# KJC-TSK-1390 (ADR 0045): the project's convention (kj gates value commit-convention):
# free or the project's own commitlint skip this header check; anything else keeps it.
kj_conv=conventional
if command -v kj >/dev/null 2>&1; then kj_conv=$(kj gates value commit-convention 2>/dev/null) || kj_conv=conventional; fi
case "$kj_conv" in
  free|project) ;;
  *)
    if ! printf '%s' "$header" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'; then
      kj_refuse header 'kj harden: commit header must follow Conventional Commits (type: subject)'
    fi
    ;;
esac
if [ "${#header}" -gt 100 ]; then kj_refuse length 'kj harden: commit header exceeds 100 chars'; fi
# KJC-TSK-0909: the rest of what CI's commitlint rejects, caught here.
if ! awk 'NR > 2 && !/^#/ && length($0) > 100 { exit 1 }' "$msg_file"; then
  kj_refuse body 'kj harden: a commit body line exceeds 100 chars (CI commitlint rejects it)'
fi
if [ -x node_modules/.bin/commitlint ]; then
  node_modules/.bin/commitlint --edit "$msg_file" || { kj_trace refuse commitlint; exit 1; }
fi
if grep -qiE 'co-authored-by:.*(claude|gpt|copilot|gemini)|(generated|written) (by|with) .*(claude|gpt|copilot)' "$msg_file"; then
  kj_refuse attribution 'kj harden: AI attribution is not allowed in commit messages'
fi
# Chain the machine's global hook, looked up when the hook runs, not when kj harden ran (KJC-TSK-0645, HU-2762).
kj_global=$(git config --global --type=path --get core.hooksPath 2>/dev/null || true)
if [ -n "$kj_global" ] && [ -x "$kj_global/commit-msg" ] && [ "$(cd "$kj_global" 2>/dev/null && pwd -P)" != "$(cd "$(dirname "$0")" && pwd -P)" ]; then
  "$kj_global/commit-msg" "$@"; rc=$?
  [ "$rc" -eq 0 ] || { kj_trace refuse global-hook; exit "$rc"; }
fi
kj_trace pass ok
# <<< kj:managed:hook:commit-msg <<<
