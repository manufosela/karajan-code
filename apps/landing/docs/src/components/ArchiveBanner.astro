---
// KJC-TSK-1350: replaces Starlight's Banner. A v3 archive page says on top, in its language,
// that it is history and that `kj run` was retired in 5.0; any banner of its own follows.
import Default from '@astrojs/starlight/components/Banner.astro';
import { isArchivePage } from '../archive.mjs';

const { id, lang } = Astro.locals.starlightRoute;
const archive = isArchivePage(id);
const es = lang === 'es';
---

{archive && (
	<div class="sl-banner kj-archive-banner" data-pagefind-ignore>
		{es
			? <>Archivo histórico: esta página describe Karajan v3. <code>kj run</code> y su pipeline se retiraron en la 5.0; tu agente hace el trabajo y Karajan lo gobierna. Consulta <a href="/docs/es/v4/migration/">Migrar a la 5.0</a>.</>
			: <>Historical archive: this page describes Karajan v3. <code>kj run</code> and its pipeline were retired in 5.0; your agent does the work and Karajan governs it. See <a href="/docs/v4/migration/">Migrating to 5.0</a>.</>}
	</div>
)}
<Default />

<style>
	.kj-archive-banner {
		padding: var(--sl-nav-pad-y) var(--sl-nav-pad-x);
		background-color: var(--sl-color-orange-low);
		color: var(--sl-color-orange-high);
		line-height: var(--sl-line-height-headings);
		text-align: center;
		text-wrap: balance;
	}
	.kj-archive-banner a,
	.kj-archive-banner code {
		color: inherit;
	}
</style>
