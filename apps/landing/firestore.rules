rules_version = '2';

// Karajan landing Firestore rules.
//
// `telemetry` is intentionally write-only via the Admin SDK from the
// `telemetry` Cloud Function. No browser, no MCP, no third-party client
// should ever read or write directly. Deny everything by default; the
// only client-reachable collection is `kjSupervisorSign` below.
service cloud.firestore {
  match /databases/{database}/documents {
    // kjSupervisorSign (KJC-TSK-0822, PRP-0023): relay for the phone
    // signature of the supervisor seal. Capability + TTL model: the doc
    // id is a 32-hex secret shared only through the signing link, so
    // `get` is open but `list` is denied (ids cannot be enumerated) and
    // `delete` is denied. A doc is only creatable as a fresh `pending`
    // request (createdAt within +-2 min of server time) and only
    // updatable once, pending -> signed, touching exactly the signature
    // fields, within 3 min of creation. After the TTL the doc is inert.
    match /kjSupervisorSign/{cid} {
      allow get: if true;
      allow list: if false;
      allow delete: if false;
      // KJC-TSK-0901: v2 adds `v` (== 2) and `expires_at`, signed by the phone
      // too; both optional so a v1 kj keeps working.
      // KJC-BUG-0303: since kj 4.46 the request also carries what the page shows
      // beside the hashes (KJC-TSK-0992 changes/branch/origin, KJC-TSK-0996 why),
      // outside the signed payload; a hasOnly without them rejected every seal (403).
      allow create: if request.resource.data.keys().hasOnly(['nonce', 'project', 'files', 'kj_version', 'createdAt', 'state', 'v', 'expires_at', 'changes', 'branch', 'origin', 'why', 'passkey', 'kind', 'user_label'])
        && (!('passkey' in request.resource.data) || request.resource.data.passkey is bool)
        // HU-3976 (ADR 0053): a register request asks the phone for a passkey with this label.
        && (!('kind' in request.resource.data) || request.resource.data.kind is string)
        && (!('user_label' in request.resource.data) || request.resource.data.user_label is string)
        && (!('changes' in request.resource.data) || request.resource.data.changes is list)
        && (!('branch' in request.resource.data) || request.resource.data.branch is string)
        && (!('origin' in request.resource.data) || request.resource.data.origin is string)
        && (!('why' in request.resource.data) || request.resource.data.why is string)
        && (!('v' in request.resource.data) || (request.resource.data.v == 2
          && request.resource.data.expires_at is timestamp
          && request.resource.data.expires_at > request.resource.data.createdAt
          // KJC-TSK-1535: up to 10 minutes, so a phone enrollment link can reach another signer.
          && request.resource.data.expires_at <= request.resource.data.createdAt + duration.value(10, 'm')))
        && request.resource.data.keys().hasAll(['nonce', 'project', 'files', 'kj_version', 'createdAt', 'state'])
        && request.resource.data.state == 'pending'
        && request.resource.data.nonce is string
        && request.resource.data.project is string
        && request.resource.data.files is list
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt > request.time - duration.value(2, 'm')
        && request.resource.data.createdAt < request.time + duration.value(2, 'm');
      allow update: if resource.data.state == 'pending'
        && request.resource.data.state == 'signed'
        // HU-3927 (ADR 0053): a passkey signature carries its assertion and credential id instead of publicKey.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'signature', 'publicKey', 'signedAt', 'authenticatorData', 'clientDataJSON', 'credentialId'])
        && (!('authenticatorData' in request.resource.data) || request.resource.data.authenticatorData is string)
        && (!('clientDataJSON' in request.resource.data) || request.resource.data.clientDataJSON is string)
        && (!('credentialId' in request.resource.data) || request.resource.data.credentialId is string)
        // KJC-TSK-1535: a v2 request is signed until its own expiry; an old one keeps the 3 minutes.
        && request.time < ('expires_at' in resource.data ? resource.data.expires_at : resource.data.createdAt + duration.value(3, 'm'));
      // HU-3976 (ADR 0053): a register request is answered once, pending -> registered, with exactly the new passkey.
      allow update: if resource.data.state == 'pending'
        && resource.data.get('kind', '') == 'register'
        && request.resource.data.state == 'registered'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'credentialId', 'publicKey', 'alg', 'signedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['state', 'credentialId', 'publicKey', 'alg', 'signedAt'])
        && request.resource.data.credentialId is string
        && request.resource.data.publicKey is string
        && request.resource.data.alg is int
        && request.resource.data.signedAt is timestamp
        && request.time < ('expires_at' in resource.data ? resource.data.expires_at : resource.data.createdAt + duration.value(3, 'm'));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
